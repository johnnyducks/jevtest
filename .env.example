# ─── Jev (TypeSafe System One API) ─────────────────────────────────────────────
# Required for LIVE decision mode. Server-side only — never prefix with NEXT_PUBLIC_.
JEV_API_KEY=
# Optional. Any name returned by GET https://api.typesafe.ai/v1/models.
JEV_MODEL=jev-latest
# Optional. Override only if you route through a proxy.
JEV_API_BASE=https://api.typesafe.ai
