# ─── Jev (TypeSafe System One API) ─────────────────────────────────────────────
# Required for LIVE decision mode. Server-side only — never prefix with NEXT_PUBLIC_.
JEV_API_KEY=
# Optional. Any name returned by GET https://api.typesafe.ai/v1/models.
JEV_MODEL=jev-latest
# Optional. Override only if you route through a proxy.
JEV_API_BASE=https://api.typesafe.ai

# ─── Marty's voice (OpenAI) ─────────────────────────────────────────────────────
# Optional. Writes Marty's chat replies in character. Without it, Marty uses
# built-in lines with the same personality.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# ─── Operator controls ─────────────────────────────────────────────────────────
# Optional. When set, the gear-menu controls (stop, resume, dock, reset, drag to
# place, speed, battery) require this key. Leave empty for a private/local show.
OPERATOR_KEY=

# ─── Card images (CardSight AI) ─────────────────────────────────────────────────
# Optional. Links the room's cards to real cards in the CardSight AI catalog and
# shows their front images (2D hover/tap, 3D). Get a key at https://cardsight.ai
CARDSIGHT_API_KEY=

# ─── Battery ────────────────────────────────────────────────────────────────────
# Optional. How many times bigger Marty's battery is than the baseline (where a
# full charge drives ~118 ft and each floor climbed costs ~7%). Default 100.
# Lower it (e.g. 5) to make battery a real constraint again; 1 = the baseline.
BATTERY_CAPACITY=100
