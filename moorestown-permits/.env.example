# ─── Claude (Anthropic API) ────────────────────────────────────────────────────
# Optional. Turns on "Ask a question" on the guide and the staff AI review.
# Server-side only — never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=

# ─── Staff console ─────────────────────────────────────────────────────────────
# Reviewers sign in with this key. Without it the console is open in
# development (npm run dev) and turned off in production (npm start).
STAFF_ACCESS_KEY=

# ─── Sessions and data ─────────────────────────────────────────────────────────
# Optional. Signs the applicant and staff cookies. Without it a random secret
# is generated and saved in the data folder.
SESSION_SECRET=
# Optional. Where the demo file store keeps applications. Default: ./.data
PERMITS_DATA_DIR=
