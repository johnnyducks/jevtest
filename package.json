    "import:lahman": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/import-lahman.ts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.1",
    "@vercel/analytics": "^2.0.1",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "typescript": "^5.9.3"
  }
}
