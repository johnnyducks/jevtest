{
  "name": "marty-live",
  "version": "0.1.0",
  "private": true,
  "description": "MARTY.LIVE: tell Marty where to go and watch it decide (Jev), plan a route and drive there on an overhead map.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
